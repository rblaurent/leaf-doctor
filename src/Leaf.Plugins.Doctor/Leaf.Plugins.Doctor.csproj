<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Leaf.Plugins.Doctor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(LeafSdkProject)' == ''">
    <PackageReference Include="Leaf.Sdk" Version="0.1.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(LeafSdkProject)' != ''">
    <ProjectReference Include="$(LeafSdkProject)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\plugin.json" LogicalName="plugin.json" />
    <InternalsVisibleTo Include="Leaf.Plugins.Doctor.Tests" />
  </ItemGroup>
</Project>
